# 复制成 .env 再填。这个文件本身不要写真实密钥。

# SQLite 落盘位置。容器里挂在 /app/data，本机跑默认用 ./data
DOJO_DATA_DIR=./data

# 允许跨域的前端地址，多个用逗号分隔
DOJO_CORS_ORIGINS=http://localhost:3006,http://127.0.0.1:3006

# ---- 模型 ----
# 服务端持有的默认模型。前端不再需要把 Key 带进浏览器。
DOJO_LLM_BASE_URL=https://api.deepseek.com
DOJO_LLM_API_KEY=
DOJO_LLM_MODEL=deepseek-chat
# openai | anthropic，决定请求体形状
DOJO_LLM_STYLE=openai

# ---- RapidAPI（TikTok 数据）----
RAPIDAPI_KEY=
RAPIDAPI_HOST=tiktok-api6.p.rapidapi.com
