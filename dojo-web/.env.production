# 【生产】环境变量

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# API 地址前缀（登录/菜单 Mock，可按需改真实后端）
VITE_API_URL = /

# 生产走 Nginx 反代，密钥在服务器 /etc/dojo/secrets.env，不打进前端包
VITE_DEEPSEEK_BASE_URL = /api/deepseek
VITE_RAPIDAPI_PROXY = true
VITE_DOJO_API_BASE = /api/dojo

# Delete console
VITE_DROP_CONSOLE = true